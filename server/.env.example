PORT=5000
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/CloudLens"
AWS_REGION=ap-south-1

# Comma-separated list of allowed frontend origins for CORS. Defaults to the
# Vite dev server's port when unset.
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# 32-byte key, hex-encoded (64 hex characters) — used to AES-256-GCM encrypt
# each connected AWS account's secret access key at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Email notifications (Nodemailer). Leave unset to use an auto-provisioned
# Ethereal test inbox in development (emails aren't really delivered, but
# every send logs a preview URL). Set these to use a real SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CloudLens <notifications@cloudlens.app>"
